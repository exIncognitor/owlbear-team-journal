{
  "name": "owlbear-team-journal",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "cloud:setup": "node scripts/setup-cloud.mjs",
    "cloud:dev": "wrangler dev --config wrangler.test.jsonc --local --port 8788"
  },
  "dependencies": {
    "@owlbear-rodeo/sdk": "^3.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261104.0-beta",
    "prettier": "^3.9.10",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
